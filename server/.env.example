PORT=8787
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8787
DATA_DIR=./data

# Origens do painel separadas por vírgula. Obrigatório ao hospedar no Netlify.
CORS_ORIGINS=http://localhost:8787,https://seu-painel.netlify.app

# Protege /api/admin. Pode ficar vazio somente no desenvolvimento local.
ADMIN_API_KEY=

# 9router / OpenAI-compatible
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=
AI_MODEL=
AI_VISION=true
AI_TIMEOUT_MS=45000
AUTO_PUBLISH_ON_AI_APPROVE=false

# Importação por link do YouTube/Shorts
# No Docker, estes caminhos já são configurados pelo Dockerfile.
# Localmente, FFMPEG_PATH vazio usa ffmpeg-static como fallback.
FFMPEG_PATH=
# Se yt-dlp não estiver no PATH, informe o caminho completo do .exe
YTDLP_PATH=yt-dlp
YT_MAX_DURATION_SEC=180
YT_DOWNLOAD_TIMEOUT_MS=600000
YT_SEARCH_CANDIDATES=200
YT_SEARCH_TARGET=100
YT_SHORTS_MAX_DURATION_SEC=90
